# -----------------------------------------------------------------------
# Required — LegiScan
# -----------------------------------------------------------------------

# LegiScan API key. Server-side only. Never expose to the client.
# Obtain from: https://legiscan.com/legiscan
LEGISCAN_API_KEY=

# -----------------------------------------------------------------------
# Required — Upstash Redis (rate limiting)
# -----------------------------------------------------------------------

# Upstash Redis REST endpoint URL.
# Create a database at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------
# Optional — Clerk (persistent authentication configuration)
# -----------------------------------------------------------------------

# Clerk supports keyless mode in local development when these values are not
# present. Set these values when claiming the application or deploying it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# App Router auth routes and post-auth fallback destinations.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/search
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/search

# -----------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------

# Canonical public URL of the deployed application.
# Used for absolute URL construction (e.g. canonical links, CORS).
# Example: https://advocata.example.com
NEXT_PUBLIC_APP_URL=
